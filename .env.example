# --- Safety (default: dry run, no live posts) ---
DRY_RUN=true
TIMEZONE=Asia/Shanghai
CONTENT_DIR=content
REPORTS_DIR=reports

# Daily caps / rate limiting
DAILY_POST_CAP=5
DAILY_ENGAGE_CAP=20
MAX_REPLIES_PER_POST=5
HTTP_TIMEOUT=30
HTTP_MAX_RETRIES=3
HTTP_BACKOFF_BASE=1.5
ENGAGE_TONE=friendly

# --- Meta Graph API (Facebook Page + Instagram Business) ---
# Long-lived Page access token with pages_manage_posts, pages_read_engagement,
# instagram_basic, instagram_content_publish, instagram_manage_comments, etc.
META_ACCESS_TOKEN=
META_PAGE_ID=
META_IG_USER_ID=
META_GRAPH_VERSION=v19.0
META_API_BASE=https://graph.facebook.com

# --- X / Twitter API v2 ---
# Prefer OAuth 1.0a user context for posting tweets
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
# Bearer useful for search/read; optional if OAuth1 is set
X_BEARER_TOKEN=
X_API_BASE=https://api.twitter.com/2

# --- Optional: OpenAI-compatible API for reply drafting ---
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
